{
  "lambda_name": "jw_authentication",
  "full_path": "/jw-api/token-auth",
  "methods": ["GET", "OPTIONS"],
  "disable_auth": ["GET", "OPTIONS"],
  "internet": "true",
  "description": "Okta token exchange, refresh, and validation",
  "runtime": "python3.12",
  "handler": "handler.handler",
  "memory_size": "512",
  "timeout": "45",
  "ephemeral_memory": "512",
  "layers": [],
  "permissions": {
    "USER": ["GET", "OPTIONS"]
  },
  "environmental_variables": {
    "ENVIRONMENT": "dev",
    "LOG_LEVEL": "INFO"
  }
}
