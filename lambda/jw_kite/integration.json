{
  "lambda_name": "jw_kite",
  "full_path": "/jw-api/kite",
  "allow_subpath": true,
  "methods": ["GET", "POST", "OPTIONS"],
  "disable_auth": ["GET", "POST", "OPTIONS"],
  "internet": "true",
  "description": "Zerodha Kite desk",
  "runtime": "python3.12",
  "handler": "handler.handler",
  "memory_size": "512",
  "timeout": "120",
  "ephemeral_memory": "512",
  "layers": [],
  "permissions": {
    "USER": ["GET", "POST", "OPTIONS"]
  },
  "environmental_variables": {
    "ENVIRONMENT": "dev",
    "LOG_LEVEL": "INFO",
    "KITE_SESSION_PATH": "/tmp/kite-session.json",
    "KITE_DB_SECRET_ID": "jakshwealth/dev/postgres",
    "SCANNER_CACHE_BUCKET": "jakshwealth-artifacts-dev-aps2",
    "SCANNER_CACHE_KEY": "kite-scanner/scanner-data.json",
    "KITE_SESSION_BUCKET": "jakshwealth-artifacts-dev-aps2",
    "KITE_SESSION_KEY": "kite-session/session.json"
  }
}
